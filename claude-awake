#!/bin/bash
#
# claude-awake — keep your MacBook (and the Claude app / Claude Code) running
#                while the lid is closed.
#
# How it works
#   * `pmset -a disablesleep 1` stops the Mac from sleeping when the lid is closed.
#     (`caffeinate` alone can NOT do this; it only blocks idle sleep.)
#   * `caffeinate -ims` additionally blocks idle/disk/system sleep while it runs.
#   * When the lid closes, `pmset displaysleepnow` turns the screen off (with
#     disablesleep=1 macOS may otherwise leave the panel lit under the lid).
#     Skipped while an external display is connected: that command sleeps every
#     display, and macOS already switches the built-in panel off in clamshell mode.
#   * Heat guard: if the battery temperature or macOS's thermal pressure stays too
#     high, it re-enables sleep and puts the Mac to sleep (`pmset sleepnow`).
#   * Low Power Mode: with the lid closed on battery at/below 35%, it turns Low
#     Power Mode on; opening the lid or plugging in puts it back.
#   * When claude-awake exits (Ctrl-C, timer, battery guard, Claude quit, terminal
#     closed), the original sleep setting is restored.
#
# Written for the stock macOS bash 3.2. No bash-4 features.

set -u

VERSION="1.4.0"
PROG="$(basename "$0")"
STATE_DIR="${HOME}/.claude-awake"
ORIG_FILE="${STATE_DIR}/original-sleep-disabled"   # value to restore
PID_FILE="${STATE_DIR}/pid"
LPM_FILE="${STATE_DIR}/original-low-power"     # "<setting> <value>" to restore
SUDOERS_FILE="/etc/sudoers.d/claude-awake"
PMSET="/usr/bin/pmset"
IOREG="/usr/sbin/ioreg"
SYSPROF="/usr/sbin/system_profiler"
NOTIFYUTIL="/usr/bin/notifyutil"

# Defaults (override with flags)
BATTERY_MIN=20        # restore sleep when on battery and at/below this %
MAX_HOURS=0           # 0 = no time limit
UNTIL_CLAUDE_EXITS=0  # 1 = stop once Claude is no longer running
LAUNCH_APP=0          # 1 = open the Claude desktop app on start
INTERVAL=30           # seconds between checks
VERBOSE=0             # 1 = print timestamped event log lines
MAX_TEMP=45           # sleep if battery stays at/above this °C (0 = off)
MAX_PRESSURE=heavy    # sleep if thermal pressure stays at/above this (off = off)
HEAT_MINUTES=2        # how long it must stay too hot before sleeping
LOW_POWER_AT=35       # Low Power Mode on battery at/below this % with the lid closed (0 = off)
LOG_FILE=""           # --log FILE: also append every event to FILE as plain text
UI_SIMPLE=0           # 1 = --simple: one status line, no banner or dashboard

CAFF_PID=""
CLEANED_UP=0

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GRN=$'\033[32m'; YLW=$'\033[33m'; RST=$'\033[0m'
else
  B=""; DIM=""; RED=""; GRN=""; YLW=""; RST=""
fi

say()  { printf '%s\n' "$*"; }
info() { printf '%s==>%s %s\n' "$B" "$RST" "$*"; }
ok()   { printf '%s✓%s %s\n' "$GRN" "$RST" "$*"; }
warn() { printf '%s!%s %s\n' "$YLW" "$RST" "$*" >&2; }
die()  { printf '%s✗ %s:%s %s\n' "$RED" "$PROG" "$RST" "$*" >&2; exit 1; }

notify() {
  # macOS notification banner; harmless if it fails.
  /usr/bin/osascript -e "display notification \"$1\" with title \"claude-awake\"" >/dev/null 2>&1 || true
}

usage() {
  cat <<EOF
${B}claude-awake ${VERSION}${RST} — keep your MacBook and Claude running with the lid closed

${B}Usage${RST}
  $PROG [start] [options]   Keep the Mac awake (lid closed OK) until Ctrl-C
  $PROG stop                Restore normal sleep (use if a run was force-killed)
  $PROG status              Show sleep setting, lid, displays, power, and Claude
  $PROG setup-sudo          Let pmset run without a password prompt (optional)
  $PROG remove-sudo         Undo setup-sudo
  $PROG diagnose            Print details to paste into a bug report (read-only)
  $PROG help

${B}Options for start${RST}
  -c, --until-claude-exits  Stop automatically once Claude (app or CLI) quits
  -l, --launch              Open the Claude desktop app first
  -b, --battery-min N       On battery, stop at N% or below (default ${BATTERY_MIN}; 0 = off)
  -t, --hours H             Stop after H hours (decimals OK, e.g. 2.5)
  -i, --interval S          Seconds between checks (default ${INTERVAL})
  -v, --verbose             Log events with timestamps (lid, screen, external
                            displays, power, battery, heat, Claude, sleep gaps)
      --log FILE            Also append every event to FILE as plain text
  -s, --simple              Simple display: one status line, no banner or dashboard

${B}Heat guard${RST} (puts the Mac to sleep if it stays too hot)
  -T, --max-temp C          Battery temperature limit in °C (default ${MAX_TEMP}; 0 = off)
  -P, --max-pressure LEVEL  Thermal pressure limit: moderate, heavy, trapping,
                            or off (default ${MAX_PRESSURE})
  -H, --heat-minutes M      How long it must stay too hot (default ${HEAT_MINUTES})

${B}Low Power Mode${RST}
  -L, --low-power-at N      With the lid closed and on battery at N% or below,
                            turn on Low Power Mode (default ${LOW_POWER_AT}; 0 = off).
                            Opening the lid or plugging in puts it back.

${B}Examples${RST}
  $PROG                      # awake until you press Ctrl-C
  $PROG -l -c                # open Claude, stay awake until it quits
  $PROG -t 3 -b 30           # at most 3 hours; stop if battery drops to 30%
  $PROG -v -c                # log lid/power/Claude events; stop when Claude quits

With an external monitor connected, screens are left on (clamshell mode).

${DIM}Safety: with the lid closed the Mac can still get hot. Leave it on a hard
surface, not in a bag. Being plugged in is best for long runs.${RST}
EOF
}

require_macbook() {
  # claude-awake is for MacBooks only: they have a lid sensor (AppleClamshellState).
  "$IOREG" -r -k AppleClamshellState -d 4 2>/dev/null | grep -q '"AppleClamshellState"' ||
    die "claude-awake is for MacBooks only, and this Mac has no lid."
}

require_macos() {
  [ "$(uname -s)" = "Darwin" ] || die "this tool only works on macOS."
  [ -x "$PMSET" ] || die "$PMSET not found."
}

# ---------------------------------------------------------------- system probes

sleep_disabled() {
  # Prints 1 if lid-close sleep is currently disabled, else 0.
  local v
  v="$("$PMSET" -g 2>/dev/null | awk '/SleepDisabled/ {print $2; exit}')"
  [ "$v" = "1" ] && echo 1 || echo 0
}

# 0 while claude-awake runs: with the lid closed nobody can answer a password
# prompt, and waiting on one would stall the heat guard. 1 at startup and exit.
SUDO_PROMPT_OK=1

set_sleep_disabled() {
  # $1 = 0|1. Tries non-interactive sudo first, then interactive if allowed.
  if sudo -n "$PMSET" -a disablesleep "$1" >/dev/null 2>&1; then return 0; fi
  if [ -t 0 ] && [ "$SUDO_PROMPT_OK" = "1" ]; then sudo "$PMSET" -a disablesleep "$1"; return $?; fi
  return 1
}

# Sets globals: BATT_PCT (empty if it can't be read), ON_AC (1/0)
read_battery() {
  local out
  out="$("$PMSET" -g batt 2>/dev/null)"
  BATT_PCT="$(printf '%s\n' "$out" | grep -Eo '[0-9]+%' | head -n1 | tr -d '%')"
  if printf '%s\n' "$out" | head -n1 | grep -q "AC Power"; then ON_AC=1; else ON_AC=0; fi
}

lid_closed() {
  # The lid sensor is exposed in the I/O Registry: AppleClamshellState = Yes when closed.
  "$IOREG" -r -k AppleClamshellState -d 4 2>/dev/null | grep -q '"AppleClamshellState" = Yes'
}

screen_off() {
  # With disablesleep=1 macOS may leave the built-in panel lit under a closed lid,
  # so turn the display off explicitly. No sudo needed. Note this sleeps EVERY
  # display, so it must not be used while an external display is in use.
  "$PMSET" displaysleepnow >/dev/null 2>&1 || true
}

# Heat sensors. Both work without sudo on Apple Silicon and Intel Macs.

read_battery_temp() {
  # Sets BATT_TEMP10: battery temperature in tenths of a °C, empty if unknown
  # (recent macOS versions no longer report it). AppleSmartBattery reports
  # hundredths of a °C, e.g. "Temperature" = 3055 is 30.55 °C.
  local raw
  raw="$("$IOREG" -r -n AppleSmartBattery 2>/dev/null |
         awk '/"Temperature" = [0-9]/ { sub(/.*"Temperature" = /, ""); print $1 + 0; exit }')"
  BATT_TEMP10=""
  case "$raw" in ''|*[!0-9]*) return 0 ;; esac
  if [ "$raw" -gt 0 ] && [ "$raw" -lt 10000 ]; then BATT_TEMP10=$((raw / 10)); fi
}

pressure_rank() {
  # Name -> rank on our scale: 0 nominal, 1 moderate, 2 heavy, 3 trapping, 4 sleeping.
  case "$1" in
    nominal) echo 0 ;; moderate) echo 1 ;; heavy) echo 2 ;;
    trapping|critical) echo 3 ;; sleeping) echo 4 ;; *) echo "" ;;
  esac
}

read_pressure() {
  # Sets PRESSURE (rank, empty if unknown) and PRESSURE_NAME from the thermal
  # pressure level macOS publishes (the same signal that drives throttling).
  local v
  v="$("$NOTIFYUTIL" -g com.apple.system.thermalpressurelevel 2>/dev/null | awk '{ print $NF; exit }')"
  PRESSURE=""; PRESSURE_NAME="unknown"
  case "$v" in ''|*[!0-9]*) return 0 ;; esac
  # macOS numbers the levels 0-4. Apple's other platforms use 0,10,...,50 with
  # 10 = "light"; accept both.
  if [ "$v" -ge 10 ]; then
    case "$v" in
      10) PRESSURE_NAME=light; PRESSURE=0 ;;
      20) PRESSURE_NAME=moderate ;; 30) PRESSURE_NAME=heavy ;;
      40) PRESSURE_NAME=trapping ;; *) PRESSURE_NAME=sleeping ;;
    esac
  else
    case "$v" in
      0) PRESSURE_NAME=nominal ;; 1) PRESSURE_NAME=moderate ;; 2) PRESSURE_NAME=heavy ;;
      3) PRESSURE_NAME=trapping ;; *) PRESSURE_NAME=sleeping ;;
    esac
  fi
  [ -n "$PRESSURE" ] || PRESSURE="$(pressure_rank "$PRESSURE_NAME")"
}

fmt_temp() { printf '%d.%d °C' $(($1 / 10)) $(($1 % 10)); }

heat_summary() {
  # One line describing current heat readings, e.g. "battery 34.2 °C, pressure nominal".
  local out=""
  [ -n "$BATT_TEMP10" ] && out="battery $(fmt_temp "$BATT_TEMP10")"
  [ -n "$PRESSURE" ] && out="${out:+$out, }pressure $PRESSURE_NAME"
  printf '%s' "${out:-unavailable}"
}

# Low Power Mode. Changed only in the battery profile (pmset -b), so the
# plugged-in settings are never touched. Changing it needs sudo.

lpm_key() {
  # Prints the pmset setting that controls Low Power Mode, or nothing.
  # Most Macs: lowpowermode (0 off, 1 on). Macs that also offer High Power Mode:
  # powermode (0 automatic, 1 low power, 2 high power). Either way 1 = low power.
  local out
  out="$("$PMSET" -g custom 2>/dev/null)"
  if printf '%s\n' "$out" | grep -qE '^[[:space:]]*lowpowermode[[:space:]]'; then echo lowpowermode
  elif printf '%s\n' "$out" | grep -qE '^[[:space:]]*powermode[[:space:]]'; then echo powermode
  fi
}

lpm_battery_value() {
  # $1 = setting. Prints its value in the "Battery Power" profile.
  "$PMSET" -g custom 2>/dev/null | awk -v k="$1" '
    /^[^[:space:]].*:[[:space:]]*$/ { sect = $0; next }
    sect ~ /^Battery Power/ && $1 == k { print $2; exit }'
}

lpm_name() {
  # $1 = setting, $2 = value -> human name
  case "$1:$2" in
    lowpowermode:1|powermode:1) echo "on" ;;
    lowpowermode:0) echo "off" ;;
    powermode:0) echo "automatic" ;;
    powermode:2) echo "High Power Mode" ;;
    *) echo "$2" ;;
  esac
}

set_lpm() {
  # $1 = setting, $2 = value. Battery profile only.
  if sudo -n "$PMSET" -b "$1" "$2" >/dev/null 2>&1; then return 0; fi
  if [ -t 0 ] && [ "$SUDO_PROMPT_OK" = "1" ]; then sudo "$PMSET" -b "$1" "$2" >/dev/null; return $?; fi
  return 1
}

lpm_restore() {
  # Put Low Power Mode back as recorded in LPM_FILE, if we changed it.
  # Sets LPM_RESTORED to the restored value's name.
  local key="" val=""
  LPM_RESTORED=""
  [ -f "$LPM_FILE" ] || return 0
  read -r key val <"$LPM_FILE" || true
  if [ -z "$key" ] || [ -z "$val" ]; then rm -f "$LPM_FILE"; return 0; fi
  if set_lpm "$key" "$val"; then
    rm -f "$LPM_FILE"; LPM_RESTORED="$(lpm_name "$key" "$val")"; return 0
  fi
  return 1
}

external_display_count() {
  # Prints how many non-built-in displays are connected and online.
  # system_profiler lists each display under a "Displays:" heading, one level
  # deeper; the built-in panel says "Built-in" or "Connection Type: Internal".
  # With the lid closed and an external display attached (clamshell mode) the
  # built-in panel is usually not listed at all.
  "$SYSPROF" SPDisplaysDataType 2>/dev/null | awk '
    function flush() { if (name != "" && !skip) n++; name = ""; skip = 0 }
    /^[[:space:]]*Displays:[[:space:]]*$/ { flush(); match($0, /^ */); din = RLENGTH; inblk = 1; next }
    inblk {
      if ($0 ~ /^[[:space:]]*$/) next
      match($0, /^ */); ind = RLENGTH
      if (ind <= din) { flush(); inblk = 0; next }
      if (ind == din + 2 && $0 ~ /:[[:space:]]*$/) { flush(); name = $0; next }
      l = tolower($0)
      if (l ~ /built-in|connection type: internal|online: no/) skip = 1
    }
    END { flush(); print n + 0 }'
}

claude_running() {
  # Claude desktop app (process "Claude") or Claude Code CLI (native "claude"
  # binary, or the npm build running under node).
  pgrep -ix claude >/dev/null 2>&1 && return 0
  pgrep -f '(^|/| )claude( |$)' >/dev/null 2>&1 && return 0
  pgrep -f '@anthropic-ai/claude-code' >/dev/null 2>&1 && return 0
  return 1
}

other_instance_pid() {
  local pid
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null)"
  [ -n "$pid" ] && [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null && { echo "$pid"; return 0; }
  return 1
}

fmt_duration() {
  local s=$1
  printf '%dh%02dm%02ds' $((s / 3600)) $((s % 3600 / 60)) $((s % 60))
}

# ---------------------------------------------------------------- commands

cmd_status() {
  require_macos
  require_macbook
  local sd pid
  sd="$(sleep_disabled)"
  read_battery
  say "${B}claude-awake status${RST}"
  if [ "$sd" = "1" ]; then
    say "  Lid-close sleep : ${GRN}disabled${RST} (Mac stays awake with lid closed)"
  else
    say "  Lid-close sleep : normal (Mac sleeps when lid closes)"
  fi
  if pid="$(other_instance_pid)"; then
    say "  claude-awake    : ${GRN}running${RST} (pid $pid)"
  else
    say "  claude-awake    : not running"
    if [ "$sd" = "1" ] && [ -f "$ORIG_FILE" ]; then
      warn "A previous run ended without restoring sleep. Run: $PROG stop"
    fi
  fi
  if claude_running; then say "  Claude          : ${GRN}running${RST}"; else say "  Claude          : not running"; fi
  if lid_closed; then say "  Lid             : closed"; else say "  Lid             : open"; fi
  local ext
  ext="$(external_display_count)"
  if [ "$ext" -gt 0 ]; then say "  External display: $ext connected (screens are left on)"
  else say "  External display: none"; fi
  read_battery_temp; read_pressure
  if [ -n "$BATT_PCT" ] && [ -z "$BATT_TEMP10" ]; then
    say "  Temperature     : $(heat_summary) (this Mac doesn't report battery temperature)"
  else
    say "  Temperature     : $(heat_summary)"
  fi
  if [ -n "$BATT_PCT" ]; then
    if [ "$ON_AC" = "1" ]; then say "  Power           : AC, battery ${BATT_PCT}%"
    else say "  Power           : battery ${BATT_PCT}%"; fi
    local key
    key="$(lpm_key)"
    if [ -n "$key" ]; then
      say "  Low Power Mode  : $(lpm_name "$key" "$(lpm_battery_value "$key")") (battery setting)"
    else
      say "  Low Power Mode  : not available on this Mac"
    fi
    if [ -f "$LPM_FILE" ] && ! other_instance_pid >/dev/null; then
      warn "A previous run left Low Power Mode changed. Run: $PROG stop"
    fi
  else
    say "  Power           : unknown (couldn't read the battery)"
  fi
}

cmd_stop() {
  require_macos
  local pid orig
  if pid="$(other_instance_pid)"; then
    info "Stopping running claude-awake (pid $pid)…"
    kill -TERM "$pid" 2>/dev/null
    # It restores sleep itself; wait briefly for it.
    local i=0
    while kill -0 "$pid" 2>/dev/null && [ $i -lt 20 ]; do sleep 0.25; i=$((i + 1)); done
  fi
  orig=0
  [ -f "$ORIG_FILE" ] && orig="$(cat "$ORIG_FILE")"
  if [ "$(sleep_disabled)" != "$orig" ]; then
    set_sleep_disabled "$orig" || die "could not restore. Run manually: sudo pmset -a disablesleep 0"
  fi
  rm -f "$ORIG_FILE" "$PID_FILE"
  ok "Normal sleep restored (SleepDisabled=$(sleep_disabled))."
  if [ -f "$LPM_FILE" ]; then
    if lpm_restore; then ok "Low Power Mode restored to $LPM_RESTORED (battery setting)."
    else warn "Could not restore Low Power Mode. Check System Settings → Battery."; fi
  fi
}

cmd_setup_sudo() {
  require_macos
  local user tmp
  user="$(id -un)"
  tmp="$(mktemp)"
  cat >"$tmp" <<EOF
# Installed by claude-awake: allow $user to toggle lid-close sleep and
# battery Low Power Mode without a password.
$user ALL=(root) NOPASSWD: $PMSET -a disablesleep 0, $PMSET -a disablesleep 1, \\
  $PMSET -b lowpowermode 0, $PMSET -b lowpowermode 1, \\
  $PMSET -b powermode 0, $PMSET -b powermode 1, $PMSET -b powermode 2
EOF
  if ! /usr/sbin/visudo -cf "$tmp" >/dev/null; then rm -f "$tmp"; die "generated sudoers rule failed validation."; fi
  info "Installing $SUDOERS_FILE (admin password required)…"
  sudo install -m 0440 -o root -g wheel "$tmp" "$SUDOERS_FILE" || { rm -f "$tmp"; die "install failed."; }
  rm -f "$tmp"
  ok "Done. '$PROG' can now change lid-close sleep and Low Power Mode without a password."
  say "${DIM}The rule only allows: pmset -a disablesleep 0|1, pmset -b lowpowermode 0|1,"
  say "pmset -b powermode 0|1|2. Undo with: $PROG remove-sudo${RST}"
}

cmd_diagnose() {
  # Read-only. Prints what a bug report needs, in a form that's safe to paste
  # publicly: no username, hostname, or serial numbers; $HOME is shown as ~.
  # Runs on any Mac (no MacBook check), so "no lid" reports can be diagnosed too.
  require_macos
  B=""; DIM=""; RED=""; GRN=""; YLW=""; RST=""     # plain text only

  local self dir commit c
  self="$0"
  [ -L "$self" ] && self="$(readlink "$self")"
  dir="$(cd "$(dirname "$self")" 2>/dev/null && pwd)"
  commit=""
  if [ -d "$dir/.git" ] && command -v git >/dev/null 2>&1 && xcode-select -p >/dev/null 2>&1; then
    commit="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
    [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ] && commit="$commit, with local changes"
  fi
  tidy() { awk -v h="$HOME" '{ while ((i = index($0, h)) > 0) $0 = substr($0, 1, i - 1) "~" substr($0, i + length(h)); print }'; }
  sect() { printf '\n## %s\n' "$1"; }

  echo "claude-awake diagnose: paste everything below into the bug report."
  echo "It contains no names, serial numbers, or file contents. Please review it before posting."

  sect "Versions"
  echo "claude-awake: $VERSION${commit:+ (git $commit)}"
  echo "installed at: $(printf '%s' "$dir" | tidy)"
  echo "macOS: $(sw_vers -productVersion 2>/dev/null) ($(sw_vers -buildVersion 2>/dev/null))"
  echo "hardware: $(sysctl -n hw.model 2>/dev/null), $(uname -m)"
  echo "bash: $BASH_VERSION"

  sect "claude-awake status"
  ( cmd_status ) 2>&1 | tidy | sed '1{/^claude-awake status$/d;}'

  sect "Sleep and power (pmset)"
  "$PMSET" -g 2>&1 | grep -E 'SleepDisabled|lowpowermode|powermode|^ *sleep |displaysleep|hibernatemode' || echo "(no matching settings)"
  echo "Low Power Mode by profile:"
  "$PMSET" -g custom 2>&1 | awk '
    /^[^[:space:]].*:[[:space:]]*$/ { sect = $0; next }
    $1 == "lowpowermode" || $1 == "powermode" { print "  " sect " " $1 " " $2; found = 1 }
    END { if (!found) print "  (no lowpowermode or powermode setting)" }'
  "$PMSET" -g batt 2>&1

  sect "Lid sensor (ioreg)"
  "$IOREG" -r -k AppleClamshellState -d 4 2>&1 | grep -oE '"AppleClamshell[A-Za-z]*" = [A-Za-z]+' || echo "(no lid sensor found)"

  sect "Heat readings"
  echo "thermal pressure: $("$NOTIFYUTIL" -g com.apple.system.thermalpressurelevel 2>&1)"
  echo "battery temperature keys (AppleSmartBattery):"
  "$IOREG" -r -n AppleSmartBattery 2>&1 | grep -oE '"[A-Za-z]*Temp[A-Za-z]*" ?= ?[0-9]+' | sort -u | sed 's/^/  /' | grep . || echo "  (none)"

  sect "Displays (system_profiler, serial numbers removed)"
  "$SYSPROF" SPDisplaysDataType 2>&1 | awk '
    /^[[:space:]]*Displays:[[:space:]]*$/ { match($0, /^ */); din = RLENGTH; inblk = 1; print; next }
    inblk {
      if ($0 ~ /^[[:space:]]*$/) next
      match($0, /^ */); if (RLENGTH <= din) { inblk = 0; next }
      if (tolower($0) ~ /serial|edid|uuid|vendor id|product id/) next
      print
    }
    END { if (din == "") print "(no displays listed)" }'

  sect "Passwordless sudo (setup-sudo)"
  if [ -f "$SUDOERS_FILE" ]; then echo "rule file: present"; else echo "rule file: not installed"; fi
  for c in "-a disablesleep 1" "-b lowpowermode 1" "-b powermode 1"; do
    # shellcheck disable=SC2086
    if sudo -n -l "$PMSET" $c >/dev/null 2>&1; then echo "pmset $c: allowed without a password"
    else echo "pmset $c: needs a password"; fi
  done

  sect "claude-awake state"
  local pid
  if pid="$(other_instance_pid)"; then echo "running: yes"; else echo "running: no"; fi
  if [ -d "$STATE_DIR" ] && [ -n "$(ls -A "$STATE_DIR" 2>/dev/null)" ]; then
    echo "state files: $(ls -A "$STATE_DIR" | grep -v '^pid$' | tr '\n' ' ')"
  else
    echo "state files: none"
  fi
}

cmd_remove_sudo() {
  require_macos
  if [ -f "$SUDOERS_FILE" ]; then
    sudo rm -f "$SUDOERS_FILE" && ok "Removed $SUDOERS_FILE."
  else
    say "Nothing to remove."
  fi
}

cleanup() {
  [ "$CLEANED_UP" = "1" ] && return
  CLEANED_UP=1
  ui_finish
  SUDO_PROMPT_OK=1
  printf '\n'
  [ -n "$CAFF_PID" ] && kill "$CAFF_PID" 2>/dev/null
  if [ -f "$LPM_FILE" ]; then
    if lpm_restore; then ok "Low Power Mode restored to $LPM_RESTORED (battery setting)."
    else warn "Could NOT restore Low Power Mode. Run: $PROG stop"; fi
  fi
  local orig=0
  [ -f "$ORIG_FILE" ] && orig="$(cat "$ORIG_FILE")"
  if set_sleep_disabled "$orig"; then
    rm -f "$ORIG_FILE" "$PID_FILE"
    if [ "$orig" = "1" ]; then
      ok "Sleep setting restored (SleepDisabled=1, as it was before claude-awake started)."
    else
      ok "Sleep setting restored (SleepDisabled=0). Closing the lid will sleep normally."
    fi
  else
    rm -f "$PID_FILE"
    warn "Could NOT restore the sleep setting. Run: $PROG stop   (or: sudo pmset -a disablesleep 0)"
    notify "Could not restore sleep. Run: claude-awake stop"
  fi
}

# ---------------------------------------------------------------- terminal UI
# Three modes, chosen when claude-awake starts (ui_init):
#   panel  a terminal at least 64 columns wide: a dashboard pinned at the bottom
#          of the window, redrawn in place
#   line   a narrower terminal, or --simple: one status line, redrawn in place
#   plain  output isn't a terminal (piped, e.g. to tee): no redraws, plain lines
# The event log (-v) scrolls above the panel or line. NO_COLOR turns colors off.
# Drawing uses only bash built-ins (no subshells or helper programs per frame).

UI_MODE=plain; UI_COLOR=0; UI_COLS=80; UI_H=0; UI_RESIZED=0; UI_FIRST=1; UI_LIVE=0
UI_W=()                                   # widths of the live lines now on screen
UI_LC=(); UI_LW=()                        # lines being built: colored text, width
HEAT_HIST=( · · · · · · · · · · · · )     # last 12 heat samples (one per 10 s)
UI_DASH="────────────────────────────────────────────────────────────────────────────────"
UI_SPIN=( ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏ )
UI_GAUGE_ON="▰▰▰▰▰▰▰▰▰▰▰▰"; UI_GAUGE_OFF="▱▱▱▱▱▱▱▱▱▱▱▱"
UI_LIMITS=""
CK_STATE=(); CK_TEXT=()                   # startup checklist: ok|off|warn, text

ui_init() {
  # Character counts (for padding) need a UTF-8 locale.
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8*|*utf-8*|*UTF8*|*utf8*) ;;
    *) # pick a UTF-8 locale that is actually installed (macOS has en_US.UTF-8)
       local l
       l="$(locale -a 2>/dev/null | grep -i -m1 -E '^(en_US\.utf-?8|c\.utf-?8|utf-?8)$')"
       if [ -n "$l" ]; then
         if [ -n "${LC_ALL:-}" ]; then LC_ALL="$l"; else LC_CTYPE="$l"; fi
       fi ;;
  esac
  if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
    UI_MODE=line
    [ -z "${NO_COLOR:-}" ] && UI_COLOR=1
    ui_size
    [ "$UI_COLS" -ge 64 ] && [ "$UI_SIMPLE" = "0" ] && UI_MODE=panel
  fi
  local e=$'\033'
  if [ "$UI_COLOR" = "1" ]; then
    C_R="$e[0m"; C_B="$e[1m"; C_TXT="$e[39m$e[1m"
    C_VIO="$e[38;5;141m"; C_VIO2="$e[38;5;99m"; C_AMB="$e[38;5;214m"; C_GRN="$e[38;5;78m"
    C_RED="$e[38;5;203m"; C_CYN="$e[38;5;37m"; C_GRY="$e[38;5;245m"; C_GRY2="$e[38;5;243m"
    C_YLW="$e[38;5;178m"
  else
    C_R=""; C_B=""; C_TXT=""; C_VIO=""; C_VIO2=""; C_AMB=""; C_GRN=""; C_RED=""
    C_CYN=""; C_GRY=""; C_GRY2=""; C_YLW=""
  fi
}

ui_size() {
  local c
  c="$(stty size </dev/tty 2>/dev/null)"; c="${c##* }"
  case "$c" in ''|*[!0-9]*|0) c="$(tput cols 2>/dev/null)" ;; esac
  case "$c" in ''|*[!0-9]*|0) c=80 ;; esac
  UI_COLS=$c
}

# Line building: ui_put appends text to the plain copy (for measuring) and the
# colored copy (for printing); ui_emit stores the finished line.
ui_reset() { UI_P=""; UI_C=""; }
ui_put() { UI_P="$UI_P$2"; if [ -n "$1" ]; then UI_C="$UI_C$1$2$C_R"; else UI_C="$UI_C$2"; fi; }
ui_padto() {
  local k=$(( $1 - ${#UI_P} ))
  [ "$k" -gt 0 ] || return 0
  printf -v UI_SP '%*s' "$k" ''; UI_P="$UI_P$UI_SP"; UI_C="$UI_C$UI_SP"
}
ui_emit() { UI_LC[${#UI_LC[@]}]="$UI_C"; UI_LW[${#UI_LW[@]}]=${#UI_P}; ui_reset; }

ui_dur()   { printf -v UI_S '%dh %02dm %02ds' $(($1 / 3600)) $((($1 / 60) % 60)) $(($1 % 60)); }
ui_short() { printf -v UI_S '%dh%02dm' $(($1 / 3600)) $((($1 / 60) % 60)); }
ui_temp()  { printf -v UI_S '%d.%d °C' $(($1 / 10)) $(($1 % 10)); }

# The panel and line read the run state from cmd_start's variables (bash
# functions see their caller's locals); every read has a default so a redraw
# is safe at any point in the loop.
ui_state() {
  S_ELAPSED=${elapsed:-0}; S_LID=${lid_was_closed:-0}; S_EXT=${ext:-0}
  S_LPM=${lpm_on:-0}; S_CLAUDE=${is_running:-}; S_HOT=${hot_since:-}
  S_GRACE=${heat_grace:-120}; S_NOW=${now:-$SECONDS}
  S_PCT=${BATT_PCT:-}; S_AC=${ON_AC:-1}; S_PR=${PRESSURE:-}; S_PRN=${PRESSURE_NAME:-unknown}
  S_T10=${BATT_TEMP10:-}
}

heat_bar() {
  # Sets HB: one bar for the heat history. Battery temperature when known
  # (25-46 °C maps onto 8 heights), otherwise the pressure level; "·" if neither.
  local lev=-1 bars="▁▂▃▄▅▆▇█"
  if [ -n "${BATT_TEMP10:-}" ]; then
    lev=$(( (BATT_TEMP10 - 250) / 30 )); [ "$lev" -lt 0 ] && lev=0; [ "$lev" -gt 7 ] && lev=7
  elif [ -n "${PRESSURE:-}" ]; then
    case "$PRESSURE" in 0) lev=0 ;; 1) lev=2 ;; 2) lev=4 ;; 3) lev=6 ;; *) lev=7 ;; esac
  fi
  if [ "$lev" -ge 0 ]; then HB="${bars:$lev:1}"; else HB="·"; fi
}

ui_heat_color() {
  if [ -n "$S_HOT" ]; then UI_HC="$C_RED"
  elif [ -z "$S_PR" ] || [ "$S_PR" -eq 0 ]; then UI_HC="$C_GRN"
  elif [ "$S_PR" -eq 1 ]; then UI_HC="$C_AMB"
  else UI_HC="$C_RED"; fi
}

ui_build_panel() {
  local W=58 CW=56 left_p left_c k on col spark
  ui_state; ui_heat_color
  UI_LC=(); UI_LW=(); ui_reset

  # ╭─ claude-awake ─────── 1.3.0 ─╮
  ui_put "$C_VIO2" "╭─ "; ui_put "$C_TXT" "claude-awake"; ui_put "$C_VIO2" " "
  k=$(( W + 2 - ${#UI_P} - ${#VERSION} - 4 ))
  ui_put "$C_VIO2" "${UI_DASH:0:$k} $VERSION ─╮"; ui_emit

  # │ ⠹ AWAKE  1h 23m 07s            lid closed · screen off │
  ui_put "$C_VIO2" "│ "
  ui_put "$C_VIO" "${UI_SPIN[$((SECONDS % 10))]}"; ui_put "" " "
  if [ -n "$S_HOT" ]; then ui_put "$C_B$C_RED" "HOT"; else ui_put "$C_B" "AWAKE"; fi
  ui_dur "$S_ELAPSED"; ui_put "" "  "; ui_put "$C_TXT" "$UI_S"
  left_p="$UI_P"; left_c="$UI_C"; ui_reset
  ui_put "$C_GRY" "lid "
  if [ "$S_LID" = "1" ]; then
    ui_put "" "closed"
    if [ "$S_EXT" -gt 0 ]; then ui_put "$C_GRY" " · external display on"; else ui_put "$C_GRY" " · screen off"; fi
  else
    ui_put "" "open"
  fi
  k=$(( CW + 2 - ${#left_p} - ${#UI_P} ))
  [ "$k" -lt 1 ] && k=1
  printf -v UI_SP '%*s' "$k" ''
  UI_P="$left_p$UI_SP$UI_P"; UI_C="$left_c$UI_SP$UI_C"
  ui_put "$C_VIO2" " │"; ui_emit

  ui_put "$C_VIO2" "│"; ui_padto $((W + 1)); ui_put "$C_VIO2" "│"; ui_emit

  # Battery  ▰▰▰▰▱▱▱▱▱▱▱▱  34% on battery  ▾ LPM
  ui_put "$C_VIO2" "│ "; ui_put "$C_GRY" "Battery   "
  if [ -n "$S_PCT" ]; then
    on=$(( (S_PCT * 12 + 50) / 100 ))
    if [ "$S_AC" = "1" ]; then col="$C_GRN"
    elif [ "$S_PCT" -le $((BATTERY_MIN + 5)) ]; then col="$C_RED"
    elif [ "$S_PCT" -le 35 ] || { [ "$LOW_POWER_AT" -gt 0 ] && [ "$S_PCT" -le "$LOW_POWER_AT" ]; }; then col="$C_AMB"
    else col="$C_TXT"; fi
    ui_put "$col" "${UI_GAUGE_ON:0:$on}"; ui_put "$C_GRY2" "${UI_GAUGE_OFF:0:$((12 - on))}"
    ui_put "" "  "; ui_put "$col" "${S_PCT}%"
    if [ "$S_AC" = "1" ]; then ui_put "$C_GRY" " plugged in"; else ui_put "$C_GRY" " on battery"; fi
    [ "$S_LPM" = "1" ] && ui_put "$C_YLW" "  ▾ LPM"
  else
    ui_put "$C_GRY" "unknown"
  fi
  ui_padto $((W + 1)); ui_put "$C_VIO2" "│"; ui_emit

  # Heat     ▁▁▂▂▃▂▂▁▁▁▂▁  nominal · 34.2 °C
  ui_put "$C_VIO2" "│ "; ui_put "$C_GRY" "Heat      "
  printf -v spark '%s' "${HEAT_HIST[@]}"
  ui_put "$UI_HC" "$spark"; ui_put "" "  "
  if [ -n "$S_HOT" ]; then
    k=$(( S_GRACE - (S_NOW - S_HOT) )); [ "$k" -lt 0 ] && k=0
    ui_put "$C_B$C_RED" "too hot"; ui_put "$C_GRY" " · sleeping in $((k / 60))m$((k % 60))s"
  elif [ -n "$S_PR" ]; then
    ui_put "$UI_HC" "$S_PRN"
    [ -n "$S_T10" ] && { ui_temp "$S_T10"; ui_put "$C_GRY" " · $UI_S"; }
  elif [ -n "$S_T10" ]; then
    ui_temp "$S_T10"; ui_put "$UI_HC" "$UI_S"
  else
    ui_put "$C_GRY" "unavailable"
  fi
  ui_padto $((W + 1)); ui_put "$C_VIO2" "│"; ui_emit

  # Claude   ● running
  ui_put "$C_VIO2" "│ "; ui_put "$C_GRY" "Claude    "
  if [ "$S_CLAUDE" = "1" ]; then ui_put "$C_GRN" "●"; ui_put "" " running"
  elif [ "$S_CLAUDE" = "0" ]; then ui_put "$C_GRY2" "○"; ui_put "" " not running"
  else ui_put "$C_GRY2" "…"; fi
  [ "$UNTIL_CLAUDE_EXITS" = "1" ] && ui_put "$C_GRY" " · stops when it quits"
  ui_padto $((W + 1)); ui_put "$C_VIO2" "│"; ui_emit

  # Display  ○ built-in only
  ui_put "$C_VIO2" "│ "; ui_put "$C_GRY" "Display   "
  if [ "$S_EXT" -gt 0 ]; then
    ui_put "$C_CYN" "●"; ui_put "" " external display"; [ "$S_EXT" -gt 1 ] && ui_put "" " ×$S_EXT"
    ui_put "$C_GRY" " · screens left on"
  else
    ui_put "$C_GRY2" "○"; ui_put "" " built-in only"
  fi
  ui_padto $((W + 1)); ui_put "$C_VIO2" "│"; ui_emit

  # limits, dimmed
  ui_put "$C_VIO2" "│ "; ui_put "$C_GRY" "$UI_LIMITS"
  ui_padto $((W + 1)); ui_put "$C_VIO2" "│"; ui_emit

  ui_put "$C_VIO2" "╰${UI_DASH:0:$W}╯"; ui_emit
}

ui_build_line() {
  # One status line from parts; parts are dropped from the end until it fits,
  # because a wrapped line would break the in-place redraw.
  local pp=() pc=() n i
  ui_state; ui_heat_color
  ui_reset; ui_put "$C_VIO" "${UI_SPIN[$((SECONDS % 10))]}"; ui_put "" " "; ui_short "$S_ELAPSED"; ui_put "$C_TXT" "$UI_S"
  pp[0]="$UI_P"; pc[0]="$UI_C"; ui_reset
  if [ -n "$S_PCT" ]; then
    if [ "$S_AC" = "1" ]; then ui_put "$C_GRN" "${S_PCT}%"; else ui_put "$C_AMB" "${S_PCT}%"; fi
    [ "$S_LPM" = "1" ] && ui_put "$C_YLW" " LPM"
  else ui_put "$C_GRY" "?%"; fi
  pp[1]="$UI_P"; pc[1]="$UI_C"; ui_reset
  ui_put "" "lid "; if [ "$S_LID" = "1" ]; then ui_put "$C_CYN" "▣"; ui_put "" " closed"; else ui_put "$C_GRY2" "□"; ui_put "" " open"; fi
  pp[2]="$UI_P"; pc[2]="$UI_C"; ui_reset
  if [ -n "$S_HOT" ]; then ui_put "$C_B$C_RED" "too hot"; else ui_put "" "heat "; ui_put "$UI_HC" "$S_PRN"; fi
  pp[3]="$UI_P"; pc[3]="$UI_C"; ui_reset
  ui_put "" "claude "; if [ "$S_CLAUDE" = "1" ]; then ui_put "$C_GRN" "●"; else ui_put "$C_GRY2" "○"; fi
  pp[4]="$UI_P"; pc[4]="$UI_C"; ui_reset
  n=5
  while :; do
    UI_P=" ${pp[0]}"; UI_C=" ${pc[0]}"
    for ((i = 1; i < n; i++)); do UI_P="$UI_P · ${pp[$i]}"; UI_C="$UI_C ${C_GRY2}·${C_R} ${pc[$i]}"; done
    [ "${#UI_P}" -lt "$UI_COLS" ] || [ "$n" -le 1 ] && break
    n=$((n - 1))
  done
  UI_LC=(); UI_LW=(); ui_emit
}

ui_resized() {
  # The window changed size. Terminal.app and iTerm2 re-wrap existing lines, so
  # work out how many rows the old live lines take now, erase them, start over.
  UI_RESIZED=0
  local rows=0 w i
  ui_size
  for ((i = 0; i < ${#UI_W[@]}; i++)); do
    w=${UI_W[$i]}
    if [ "$w" -le 0 ]; then rows=$((rows + 1)); else rows=$(( rows + (w + UI_COLS - 1) / UI_COLS )); fi
  done
  [ "$rows" -gt 0 ] && printf '\033[%dA\r\033[J' "$rows"
  UI_H=0; UI_W=()
  if [ "$UI_COLS" -ge 64 ] && [ "$UI_SIMPLE" = "0" ]; then UI_MODE=panel; else UI_MODE=line; fi
}

ui_draw() {
  [ "$UI_LIVE" = "1" ] || return 0
  [ "$UI_RESIZED" = "1" ] && ui_resized
  if [ "$UI_MODE" = "panel" ]; then ui_build_panel; else ui_build_line; fi
  local out="" i
  [ "$UI_H" -gt 0 ] && out=$'\033'"[${UI_H}A"$'\r'
  for ((i = 0; i < ${#UI_LC[@]}; i++)); do out="$out${UI_LC[$i]}"$'\033[K\n'; done
  printf '%s' "$out"
  UI_H=${#UI_LC[@]}; UI_W=( "${UI_LW[@]}" )
}

ui_clear() {
  # Erase the live lines (the cursor sits just below them).
  [ "$UI_RESIZED" = "1" ] && { ui_resized; return 0; }
  [ "$UI_H" -gt 0 ] && printf '\033[%dA\r\033[J' "$UI_H"
  UI_H=0
}

ui_start() {
  # Begin the live view: hide the cursor and draw.
  [ "$UI_MODE" = "plain" ] && return 0
  UI_LIVE=1
  printf '\033[?25l'
  trap 'UI_RESIZED=1' WINCH
  ui_draw
}

ui_finish() {
  # Leave the last view on screen, give the cursor back, stop redrawing.
  [ "$UI_LIVE" = "1" ] || return 0
  UI_LIVE=0; UI_H=0
  printf '\033[?25h'
}

event() {
  # Log an event: to --log FILE (always), and on screen above the live view (-v).
  #   event <kind> <text> [detail]
  local kind="$1" text="$2" detail="${3:-}" sym col t conn line room
  if [ -n "$LOG_FILE" ]; then
    { printf '%s  %s%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$text" "${detail:+ — $detail}" >>"$LOG_FILE"; } 2>/dev/null
  fi
  [ "$VERBOSE" = "1" ] || return 0
  case "$kind" in
    start|claude) sym="◆"; col="$C_VIO" ;;
    lid-closed)   sym="▣"; col="$C_CYN" ;;
    lid-open)     sym="□"; col="$C_CYN" ;;
    display)      sym="◇"; col="$C_CYN" ;;
    power-ac)     sym="↯"; col="$C_GRN" ;;
    power-batt)   sym="↯"; col="$C_AMB" ;;
    battery)      sym="▪"; col="$C_AMB" ;;
    lpm)          sym="▾"; col="$C_YLW" ;;
    heat-ok)      sym="≈"; col="$C_GRN" ;;
    heat-warm)    sym="≈"; col="$C_AMB" ;;
    heat-hot)     sym="≈"; col="$C_RED" ;;
    stop)         sym="■"; col="$C_AMB" ;;
    error)        sym="✗"; col="$C_RED" ;;
    *)            sym="!"; col="$C_AMB" ;;
  esac
  t="$(date '+%H:%M:%S')"
  if [ "$UI_LIVE" != "1" ]; then
    printf '%s  %s %s%s\n' "$t" "$sym" "$text" "${detail:+ — $detail}"
    return 0
  fi
  conn="├"; [ "$UI_FIRST" = "1" ] && { conn="┬"; UI_FIRST=0; }
  ui_clear
  # "  hh:mm:ss ├ x " is 15 columns: drop the detail, then shorten, to fit.
  room=$(( UI_COLS - 16 )); line="$text${detail:+ — $detail}"
  if [ "${#line}" -gt "$room" ]; then
    detail=""
    [ "${#text}" -gt "$room" ] && text="${text:0:$((room - 1))}…"
  fi
  printf '  %s%s %s%s %s%s%s %s%s%s%s\n' "$C_GRY2" "$t" "$conn" "$C_R" "$col" "$sym" "$C_R" \
    "$text" "${detail:+ ${C_GRY}— }" "$detail" "${detail:+${C_R}}"
  ui_draw
}

ui_splash() {
  # Startup: banner, what's active (CK_STATE / CK_TEXT), and a short footer.
  local i n=${#CK_TEXT[@]} mark two=0 half
  if [ "$UI_MODE" = "plain" ]; then
    say "claude-awake $VERSION: keeping this MacBook awake with the lid closed."
  elif [ "$UI_COLS" -lt 58 ] || [ "$UI_SIMPLE" = "1" ]; then
    printf '\n  %s%sclaude-awake%s %s%s%s\n' "$C_B" "$C_VIO" "$C_R" "$C_GRY2" "$VERSION" "$C_R"
  else
    local top=( "█▀▀" "█  " "▄▀█" "█ █" "█▀▄" "█▀▀" "▄▄▄" "▄▀█" "█ █ █" "▄▀█" "█▄▀" "█▀▀" )
    local bot=( "█▄▄" "█▄▄" "█▀█" "█▄█" "█▄▀" "██▄" "   " "█▀█" "▀▄▀▄▀" "█▀█" "█ █" "██▄" )
    local cols=( 99 99 135 135 141 177 213 213 209 214 214 221 ) l1="  " l2="  "
    for ((i = 0; i < 12; i++)); do
      if [ "$UI_COLOR" = "1" ]; then
        l1="$l1"$'\033'"[38;5;${cols[$i]}m${top[$i]} "; l2="$l2"$'\033'"[38;5;${cols[$i]}m${bot[$i]} "
      else
        l1="$l1${top[$i]} "; l2="$l2${bot[$i]} "
      fi
    done
    printf '\n%s%s\n%s%s\n' "$l1" "$C_R" "$l2" "$C_R"
    if [ "$UI_COLS" -ge 64 ]; then
      printf '  %skeep your MacBook and Claude running with the lid closed%s  %s%s%s\n' "$C_GRY" "$C_R" "$C_GRY2" "$VERSION" "$C_R"
    else
      printf '  %skeep your MacBook and Claude running%s %s%s%s\n' "$C_GRY" "$C_R" "$C_GRY2" "$VERSION" "$C_R"
    fi
  fi
  printf '\n'
  [ "$UI_MODE" = "panel" ] && [ "$UI_COLS" -ge 78 ] && two=1
  half=$(( (n + 1) / 2 ))
  for ((i = 0; i < n; i++)); do
    [ "$two" = "1" ] && [ "$i" -ge "$half" ] && break
    ui_ckline "$i"; ui_reset
    if [ "$two" = "1" ] && [ $((i + half)) -lt "$n" ]; then
      UI_P="$UI_CK_P"; UI_C="$UI_CK_C"; ui_padto 40
      local p1="$UI_P" c1="$UI_C"
      ui_ckline $((i + half)); printf '%s%s\n' "$c1" "$UI_CK_C"
    else
      printf '%s\n' "$UI_CK_C"
    fi
  done
  printf '\n  %sCtrl-C stops it and restores your settings.%s' "$C_GRY" "$C_R"
  [ "$VERBOSE" = "1" ] || printf ' %s-v shows an event log.%s' "$C_GRY" "$C_R"
  printf '\n  %sKeep the MacBook on a hard surface, not in a bag.%s\n\n' "$C_GRY" "$C_R"
}

ui_ckline() {  # one checklist item -> UI_CK_P / UI_CK_C
  ui_reset; ui_put "" "  "
  case "${CK_STATE[$1]}" in
    ok)   ui_put "$C_GRN" "✓" ;;
    warn) ui_put "$C_AMB" "!" ;;
    *)    ui_put "$C_GRY2" "○" ;;
  esac
  if [ "${CK_STATE[$1]}" = "off" ]; then ui_put "$C_GRY" " ${CK_TEXT[$1]}"; else ui_put "" " ${CK_TEXT[$1]}"; fi
  UI_CK_P="$UI_P"; UI_CK_C="$UI_C"
}

ck() { CK_STATE[${#CK_STATE[@]}]="$1"; CK_TEXT[${#CK_TEXT[@]}]="$2"; }

stop_with() {
  # $1 = reason. Shown in terminal and as a notification.
  event stop "Stopping" "$1"
  ui_finish
  printf '\n'
  info "$1"
  notify "$1 — normal sleep restored."
  exit 0
}

heat_sleep() {
  # $1 = what was too hot, $2 = for how long (optional). Put the Mac to sleep now.
  local msg="Too hot${2:+ for $2}: $1"
  event heat-hot "$msg" "putting the Mac to sleep"
  ui_finish
  printf '\n'
  warn "${msg}. Putting the Mac to sleep."
  notify "${msg}. Putting the Mac to sleep."
  [ -n "$CAFF_PID" ] && kill "$CAFF_PID" 2>/dev/null
  CAFF_PID=""
  # Sleep must be allowed for sleepnow to work, even if it was disabled before
  # claude-awake started; the original setting is restored when we exit.
  set_sleep_disabled 0 >/dev/null 2>&1 || warn "Could not re-enable sleep."
  "$PMSET" sleepnow >/dev/null 2>&1 || warn "pmset sleepnow failed."
  # The Mac sleeps within seconds and this process freezes; after wake it
  # resumes here, exits, and cleanup restores the original sleep setting.
  sleep 20 &
  wait $! 2>/dev/null
  exit 0
}

cmd_start() {
  require_macos
  require_macbook

  while [ $# -gt 0 ]; do
    case "$1" in
      -c|--until-claude-exits) UNTIL_CLAUDE_EXITS=1 ;;
      -l|--launch)             LAUNCH_APP=1 ;;
      -b|--battery-min)        shift; BATTERY_MIN="${1:-}" ;;
      -t|--hours)              shift; MAX_HOURS="${1:-}" ;;
      -i|--interval)           shift; INTERVAL="${1:-}" ;;
      -v|--verbose)            VERBOSE=1 ;;
      --log)                   shift; LOG_FILE="${1:-}"; [ -n "$LOG_FILE" ] || die "--log needs a file name." ;;
      -s|--simple)             UI_SIMPLE=1 ;;
      -T|--max-temp)           shift; MAX_TEMP="${1:-}" ;;
      -P|--max-pressure)       shift; MAX_PRESSURE="${1:-}" ;;
      -H|--heat-minutes)       shift; HEAT_MINUTES="${1:-}" ;;
      -L|--low-power-at)       shift; LOW_POWER_AT="${1:-}" ;;
      -h|--help)               usage; exit 0 ;;
      *) die "unknown option: $1 (see '$PROG help')" ;;
    esac
    shift
  done

  case "$BATTERY_MIN" in ''|*[!0-9]*) die "--battery-min needs a whole number 0-100." ;; esac
  case "$MAX_TEMP"    in ''|*[!0-9]*) die "--max-temp needs a whole number of °C (0 = off)." ;; esac
  local max_pressure_rank=0
  if [ "$MAX_PRESSURE" != "off" ]; then
    max_pressure_rank="$(pressure_rank "$MAX_PRESSURE")"
    case "$max_pressure_rank" in 1|2|3) ;; *) die "--max-pressure must be moderate, heavy, trapping, or off." ;; esac
  fi
  printf '%s' "$HEAT_MINUTES" | grep -Eq '^[0-9]+(\.[0-9]+)?$' || die "--heat-minutes needs a number, e.g. 2 or 0.5"
  local heat_grace
  heat_grace="$(awk -v m="$HEAT_MINUTES" 'BEGIN { printf "%d", m * 60 }')"
  case "$LOW_POWER_AT" in ''|*[!0-9]*) die "--low-power-at needs a whole number 0-100 (0 = off)." ;; esac
  [ "$LOW_POWER_AT" -le 100 ] || die "--low-power-at needs a whole number 0-100 (0 = off)."
  case "$INTERVAL"    in ''|*[!0-9]*|0) die "--interval needs a positive whole number." ;; esac
  printf '%s' "$MAX_HOURS" | grep -Eq '^[0-9]+(\.[0-9]+)?$' || die "--hours needs a number, e.g. 2 or 1.5"
  local max_secs
  max_secs="$(awk -v h="$MAX_HOURS" 'BEGIN { printf "%d", h * 3600 }')"

  local pid
  if pid="$(other_instance_pid)"; then
    die "already running (pid $pid). Use '$PROG status' or '$PROG stop'."
  fi
  ui_init
  if [ -n "$LOG_FILE" ]; then
    { : >>"$LOG_FILE"; } 2>/dev/null || die "can't write to the log file: $LOG_FILE"
  fi

  mkdir -p "$STATE_DIR"

  # Remember the value to restore. If a previous run crashed, keep ITS original.
  local created_orig=0
  if [ ! -f "$ORIG_FILE" ]; then
    sleep_disabled >"$ORIG_FILE"; created_orig=1
  fi

  # Get sudo rights up front (no prompt if setup-sudo was run).
  if ! sudo -n "$PMSET" -a disablesleep 1 >/dev/null 2>&1; then
    info "Administrator password needed to change the lid-close sleep setting."
    sudo -v || { [ "$created_orig" = 1 ] && rm -f "$ORIG_FILE"; die "sudo failed."; }
  fi
  echo $$ >"$PID_FILE"

  if [ -f "$LPM_FILE" ]; then
    lpm_restore && info "Restored Low Power Mode left changed by a previous run ($LPM_RESTORED)."
  fi

  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP

  set_sleep_disabled 1 || die "could not disable sleep (pmset failed)."
  /usr/bin/caffeinate -ims -w $$ &
  CAFF_PID=$!

  if [ "$LAUNCH_APP" = "1" ]; then
    info "Opening Claude…"
    open -a Claude 2>/dev/null || warn "Could not open the Claude app (is it installed in /Applications?)."
    sleep 3
  fi

  local seen_claude=0
  if [ "$UNTIL_CLAUDE_EXITS" = "1" ]; then
    claude_running && seen_claude=1
  fi

  read_battery; read_battery_temp; read_pressure
  # Low Power Mode needs a battery and a pmset setting for it.
  local LPM_KEY=""
  if [ "$LOW_POWER_AT" -gt 0 ] && [ -n "$BATT_PCT" ]; then LPM_KEY="$(lpm_key)"; fi

  # What's active, for the startup checklist and the panel's limits line.
  local heat_rule="" limits=""
  if [ "$MAX_TEMP" -gt 0 ] && [ -n "$BATT_TEMP10" ]; then heat_rule="${MAX_TEMP} °C"; fi
  if [ "$max_pressure_rank" -gt 0 ] && [ -n "$PRESSURE" ]; then
    if [ -n "$heat_rule" ]; then heat_rule="$heat_rule or $MAX_PRESSURE"; else heat_rule="pressure ≥ $MAX_PRESSURE"; fi
  fi
  ck ok "lid-close sleep disabled"
  ck ok "screen off under the lid"
  if [ -n "$heat_rule" ]; then
    ck ok "heat guard: $heat_rule, $HEAT_MINUTES min"; limits="heat: ${heat_rule#pressure ≥ } ${HEAT_MINUTES}m"
  elif [ "$MAX_TEMP" -gt 0 ] || [ "$max_pressure_rank" -gt 0 ]; then
    ck warn "heat guard off (no reading)"
  else
    ck off "heat guard (off)"
  fi
  if [ -n "$LPM_KEY" ]; then
    ck ok "Low Power Mode at ${LOW_POWER_AT}%"; limits="${limits:+$limits · }LPM ${LOW_POWER_AT}%"
  elif [ "$LOW_POWER_AT" -gt 0 ]; then
    ck off "Low Power Mode (not available)"
  else
    ck off "Low Power Mode (off)"
  fi
  if [ "$BATTERY_MIN" -gt 0 ]; then
    ck ok "stop on battery at ${BATTERY_MIN}%"; limits="stop ${BATTERY_MIN}%${limits:+ · $limits}"
  else
    ck off "battery stop (off)"
  fi
  if [ "$max_secs" -gt 0 ]; then
    ck ok "stop after ${MAX_HOURS} h"; limits="${limits:+$limits · }limit ${MAX_HOURS}h"
  else
    ck off "time limit (none)"
  fi
  [ "$UNTIL_CLAUDE_EXITS" = "1" ] && ck ok "stop when Claude quits"
  [ "${#limits}" -gt 56 ] && limits="${limits:0:55}…"
  UI_LIMITS="$limits"

  ui_splash
  if [ "$MAX_TEMP" -gt 0 ] || [ "$max_pressure_rank" -gt 0 ]; then
    [ -z "$heat_rule" ] && warn "Can't read any temperature on this Mac, so the heat guard is off."
  fi
  if [ "$LOW_POWER_AT" -gt 0 ] && [ -n "$BATT_PCT" ] && [ -z "$LPM_KEY" ]; then
    warn "Low Power Mode can't be changed on this Mac (no pmset setting for it)."
  fi
  [ "$UNTIL_CLAUDE_EXITS" = "1" ] && [ "$seen_claude" = "0" ] && warn "Claude isn't running yet. I'll stop once it has started and then quit."

  # Cadences: every TICK (1 s) the lid is checked and the view redrawn, so the
  # screen goes dark within a second or two of closing; everything else runs
  # every INTERVAL seconds.
  # External displays are checked every DISPLAY_CHECK s (system_profiler is slow),
  # and immediately when the lid closes.
  local TICK=1 SCREEN_REPEAT=30 GAP_WARN=20 DISPLAY_CHECK=10
  local start=$SECONDS now=$SECONDS prev_tick=$SECONDS elapsed=0 gap
  local next_check=0 lid_was_closed=-1 lid_closed_at=0 last_screen_off=-999
  local prev_on_ac="" prev_batt_step="" prev_claude="" sudo_warned=0 is_running
  local ext=0 prev_ext="" next_display_check=0
  # Heat guard: checked every HEAT_CHECK s; must stay too hot for heat_grace s.
  local HEAT_CHECK=10 next_heat_check=0 hot_since="" hot_reason prev_pressure=""
  # Low Power Mode: lpm_on = we're in the low-power state (set by us, or it was
  # already on); lpm_failed stops retrying until the conditions change.
  local lpm_on=0 lpm_failed=0 lpm_notified=0 lpm_want lpm_cur lpm_why
  local is_running=""

  heat_bar; HEAT_HIST=( "$HB" "$HB" "$HB" "$HB" "$HB" "$HB" "$HB" "$HB" "$HB" "$HB" "$HB" "$HB" )
  SUDO_PROMPT_OK=0
  ui_start
  event start "claude-awake started" "lid-close sleep disabled (was SleepDisabled=$(cat "$ORIG_FILE" 2>/dev/null || echo 0))"
  while :; do
    now=$SECONDS
    elapsed=$((now - start))

    # A tick far longer than TICK means the process was frozen: the Mac slept.
    gap=$((now - prev_tick))
    if [ "$gap" -gt $((TICK + GAP_WARN)) ]; then
      event warn "No activity for $(fmt_duration "$gap")" "the Mac appears to have slept"
    fi
    prev_tick=$now

    if [ "$now" -ge "$next_display_check" ]; then
      next_display_check=$((now + DISPLAY_CHECK))
      ext="$(external_display_count)"
      if [ "$ext" != "$prev_ext" ]; then
        if [ "$ext" -gt 0 ]; then
          event display "External display connected ($ext)" "screens left on"
        elif [ -n "$prev_ext" ]; then
          event display "External display disconnected"
          last_screen_off=-999   # lid closed? turn the built-in panel off on this tick
        fi
        prev_ext=$ext
      fi
    fi

    if lid_closed; then
      if [ "$lid_was_closed" != "1" ]; then
        lid_closed_at=$now
        # Re-check now so closing the lid onto an external display never blanks it.
        ext="$(external_display_count)"; prev_ext=$ext
        next_display_check=$((now + DISPLAY_CHECK))
        if [ "$ext" -gt 0 ]; then
          event lid-closed "Lid closed" "external display in use, leaving it on"
        else
          screen_off; last_screen_off=$now
          event lid-closed "Lid closed" "screen turned off"
        fi
      elif [ "$ext" -eq 0 ] && [ $((now - last_screen_off)) -ge "$SCREEN_REPEAT" ]; then
        # Repeat every SCREEN_REPEAT s in case something (a notification, a USB
        # event) woke the panel behind the lid.
        screen_off; last_screen_off=$now
      fi
      lid_was_closed=1
    else
      if [ "$lid_was_closed" = "1" ]; then
        event lid-open "Lid opened" "was closed $(fmt_duration $((now - lid_closed_at)))"
      elif [ "$lid_was_closed" = "-1" ]; then
        event lid-open "Lid is open"
      fi
      lid_was_closed=0
    fi

    # Low Power Mode: on with the lid closed, on battery, at/below LOW_POWER_AT.
    # Opening the lid or plugging in puts it back the way it was.
    if [ -n "$LPM_KEY" ]; then
      lpm_want=0
      if [ "$lid_was_closed" = "1" ] && [ -n "$BATT_PCT" ] && [ "$ON_AC" = "0" ] && [ "$BATT_PCT" -le "$LOW_POWER_AT" ]; then
        lpm_want=1
      fi
      if [ "$lpm_want" = "1" ] && [ "$lpm_on" = "0" ] && [ "$lpm_failed" = "0" ]; then
        lpm_cur="$(lpm_battery_value "$LPM_KEY")"
        if [ "$lpm_cur" = "1" ]; then
          lpm_on=1                                  # already on: nothing to restore later
          event lpm "Low Power Mode is already on" "battery ${BATT_PCT}%"
        elif [ -n "$lpm_cur" ]; then
          echo "$LPM_KEY $lpm_cur" >"$LPM_FILE"
          if set_lpm "$LPM_KEY" 1; then
            lpm_on=1
            event lpm "Low Power Mode on" "battery ${BATT_PCT}%, lid closed"
            if [ "$lpm_notified" = "0" ]; then
              notify "Battery at ${BATT_PCT}%: Low Power Mode on until you open the lid or plug in."
              lpm_notified=1
            fi
          else
            rm -f "$LPM_FILE"; lpm_failed=1
            event warn "Could not turn on Low Power Mode" "sudo needed; see setup-sudo"
          fi
        else
          lpm_failed=1
          event warn "Could not read the Low Power Mode setting"
        fi
      elif [ "$lpm_want" = "0" ]; then
        if [ "$lpm_on" = "1" ]; then
          if [ "$lid_was_closed" != "1" ]; then lpm_why="lid opened"; else lpm_why="plugged in"; fi
          if [ -f "$LPM_FILE" ]; then
            if lpm_restore; then event lpm "Low Power Mode back to $LPM_RESTORED" "$lpm_why"
            else event warn "Could not restore Low Power Mode" "will retry at exit"; fi
          else
            event lpm "Low Power Mode left on" "$lpm_why; it was on before"
          fi
          lpm_on=0
        fi
        lpm_failed=0
      fi
    fi

    if [ "$now" -ge "$next_check" ]; then
      next_check=$((now + INTERVAL))

      # Keep the sudo timestamp fresh so the restore at exit doesn't need a password.
      if ! sudo -n -v >/dev/null 2>&1 && ! sudo -n -l "$PMSET" -a disablesleep 0 >/dev/null 2>&1; then
        if [ "$sudo_warned" = "0" ]; then
          event warn "sudo session expired" "restoring sleep at exit may ask for your password"
          sudo_warned=1
        fi
      fi

      # Re-assert in case something else flipped it back.
      if [ "$(sleep_disabled)" != "1" ]; then
        event warn "SleepDisabled was reset by something else" "re-applying"
        set_sleep_disabled 1 >/dev/null 2>&1 || event error "Could not re-apply SleepDisabled=1"
      fi

      read_battery

      if [ -n "$BATT_PCT" ]; then
        if [ "$ON_AC" != "$prev_on_ac" ]; then
          if [ "$ON_AC" = "1" ]; then event power-ac "Plugged in" "${BATT_PCT}%"
          else event power-batt "On battery" "${BATT_PCT}%"; fi
        elif [ "$ON_AC" = "0" ] && [ $((BATT_PCT / 5)) != "$prev_batt_step" ]; then
          event battery "Battery ${BATT_PCT}%"
        fi
        prev_on_ac=$ON_AC; prev_batt_step=$((BATT_PCT / 5))
      fi

      if claude_running; then is_running=1; seen_claude=1; else is_running=0; fi
      if [ "$is_running" != "$prev_claude" ]; then
        if [ "$is_running" = "1" ]; then event claude "Claude is running"
        elif [ -n "$prev_claude" ]; then event claude "Claude quit"
        else event claude "Claude is not running"; fi
        prev_claude=$is_running
      fi
    fi

    if [ "$now" -ge "$next_heat_check" ]; then
      next_heat_check=$((now + HEAT_CHECK))
      read_battery; read_battery_temp; read_pressure

      if [ -n "$PRESSURE" ] && [ "$PRESSURE_NAME" != "$prev_pressure" ]; then
        if [ -n "$prev_pressure" ]; then
          case "$PRESSURE" in 0) event heat-ok "Thermal pressure $PRESSURE_NAME" ;; 1) event heat-warm "Thermal pressure $PRESSURE_NAME" ;; *) event heat-hot "Thermal pressure $PRESSURE_NAME" ;; esac
        fi
        prev_pressure=$PRESSURE_NAME
      fi

      hot_reason=""
      if [ "$MAX_TEMP" -gt 0 ] && [ -n "$BATT_TEMP10" ] && [ "$BATT_TEMP10" -ge $((MAX_TEMP * 10)) ]; then
        hot_reason="battery $(fmt_temp "$BATT_TEMP10") (limit ${MAX_TEMP} °C)"
      fi
      if [ "$max_pressure_rank" -gt 0 ] && [ -n "$PRESSURE" ] && [ "$PRESSURE" -ge "$max_pressure_rank" ]; then
        hot_reason="${hot_reason:+$hot_reason; }thermal pressure $PRESSURE_NAME"
      fi

      if [ -n "$hot_reason" ]; then
        if [ "$max_pressure_rank" -gt 0 ] && [ -n "$PRESSURE" ] && [ "$PRESSURE" -ge 3 ]; then
          heat_sleep "$hot_reason"            # trapping/sleeping: act immediately
        elif [ -z "$hot_since" ]; then
          hot_since=$now
          event heat-hot "Too hot: $hot_reason" "will sleep the Mac if it lasts ${HEAT_MINUTES} min"
        elif [ $((now - hot_since)) -ge "$heat_grace" ]; then
          heat_sleep "$hot_reason" "$(fmt_duration $((now - hot_since)))"
        fi
      elif [ -n "$hot_since" ]; then
        event heat-ok "Cooled down after $(fmt_duration $((now - hot_since)))" "$(heat_summary)"
        hot_since=""
      fi

      heat_bar; HEAT_HIST=( "${HEAT_HIST[@]:1}" "$HB" )     # panel heat history
    fi

    ui_draw

    if [ -n "$BATT_PCT" ] && [ "$ON_AC" = "0" ] && [ "$BATTERY_MIN" -gt 0 ] && [ "$BATT_PCT" -le "$BATTERY_MIN" ]; then
      stop_with "Battery at ${BATT_PCT}% (limit ${BATTERY_MIN}%), letting the Mac sleep"
    fi
    if [ "$max_secs" -gt 0 ] && [ "$elapsed" -ge "$max_secs" ]; then
      stop_with "Time limit of ${MAX_HOURS}h reached"
    fi
    if [ "$UNTIL_CLAUDE_EXITS" = "1" ] && [ "$seen_claude" = "1" ] && [ "$is_running" = "0" ]; then
      stop_with "Claude has quit"
    fi

    # Sleep in the background + wait, so Ctrl-C/TERM are handled immediately.
    sleep "$TICK" &
    wait $! 2>/dev/null
  done
}

# ---------------------------------------------------------------- main

case "${1:-start}" in
  start)                  [ $# -gt 0 ] && shift; cmd_start "$@" ;;
  -*)                     cmd_start "$@" ;;
  stop|off)               cmd_stop ;;
  status)                 cmd_status ;;
  setup-sudo)             cmd_setup_sudo ;;
  remove-sudo)            cmd_remove_sudo ;;
  diagnose)               cmd_diagnose ;;
  help|--help|-h)         usage ;;
  version|--version|-V)   echo "claude-awake $VERSION" ;;
  *)                      die "unknown command: $1 (see '$PROG help')" ;;
esac
